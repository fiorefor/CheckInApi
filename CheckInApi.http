@CheckInApi_HostAddress = http://localhost:5129
@idPasajero = 1
@documento = 12345678
@codigoEtiqueta = EQ001

### Inicio

# Menu de la API
GET {{CheckInApi_HostAddress}}/api
Accept: application/json

###

### Pasajeros

# Obtener todos los pasajeros
GET {{CheckInApi_HostAddress}}/api/Pasajero
Accept: application/json

###

# Obtener un pasajero por ID
GET {{CheckInApi_HostAddress}}/api/Pasajero/{{idPasajero}}
Accept: application/json

###

# Obtener un pasajero por documento
GET {{CheckInApi_HostAddress}}/api/Pasajero/documento/{{documento}}
Accept: application/json

###

# Agregar un pasajero
POST {{CheckInApi_HostAddress}}/api/Pasajero
Content-Type: application/json

{
  "nombre": "Ada",
  "apellido": "Lovelace",
  "documento": "{{documento}}",
  "email": "ada@example.com",
  "telefono": "1122334455",
  "pasajeroFrecuente": "true"
}

###

# Actualizar un pasajero existente
PUT {{CheckInApi_HostAddress}}/api/Pasajero/{{idPasajero}}
Content-Type: application/json

{
  "nombre": "Ada",
  "apellido": "Byron",
  "documento": "{{documento}}",
  "email": "ada@example.com",
  "telefono": "1122334455",
  "pasajeroFrecuente": "true"
}

###

# Eliminar un pasajero por ID
DELETE {{CheckInApi_HostAddress}}/api/Pasajero/{{idPasajero}}
Accept: application/json

###

### Pasajes

# Obtener todos los pasajes
GET {{CheckInApi_HostAddress}}/api/Pasajes
Accept: application/json

###

# Consultar el pasaje de un pasajero
GET {{CheckInApi_HostAddress}}/api/Pasajes/{{idPasajero}}
Accept: application/json

###

# Asignar un pasaje
POST {{CheckInApi_HostAddress}}/api/Pasajes/{{idPasajero}}
Content-Type: application/json

{
  "tipoVuelo": "N",
  "tipoTarifa": "P",
  "nroVuelo": "AR1234"
}

###

# Actualizar un pasaje existente
PUT {{CheckInApi_HostAddress}}/api/Pasajes/{{idPasajero}}
Content-Type: application/json

{
  "tipoVuelo": "I",
  "tipoTarifa": "PE",
  "nroVuelo": "AR5678"
}

###

# Eliminar el pasaje de un pasajero
DELETE {{CheckInApi_HostAddress}}/api/Pasajes/{{idPasajero}}
Accept: application/json

###

### Equipajes

# Obtener todos los equipajes
GET {{CheckInApi_HostAddress}}/api/Equipaje
Accept: application/json

###

# Obtener los equipajes de un pasajero
GET {{CheckInApi_HostAddress}}/api/Equipaje/{{idPasajero}}
Accept: application/json

###

# Obtener un equipaje por código de etiqueta
GET {{CheckInApi_HostAddress}}/api/Equipaje/{{idPasajero}}/{{codigoEtiqueta}}
Accept: application/json

###

# Registrar un equipaje para un pasajero
POST {{CheckInApi_HostAddress}}/api/Equipaje/{{idPasajero}}
Content-Type: application/json

{
  "codigoEtiqueta": "{{codigoEtiqueta}}",
  "tipoEquipaje": "bodega",
  "pesoKg": 23.5
}

###

# Actualizar un equipaje existente
PUT {{CheckInApi_HostAddress}}/api/Equipaje/{{idPasajero}}/{{codigoEtiqueta}}
Content-Type: application/json

{
  "codigoEtiqueta": "{{codigoEtiqueta}}",
  "tipoEquipaje": "mano",
  "pesoKg": 8.0
}

###

# Eliminar un equipaje
DELETE {{CheckInApi_HostAddress}}/api/Equipaje/{{idPasajero}}/{{codigoEtiqueta}}
Accept: application/json
